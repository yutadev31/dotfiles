[global]
  corner_radius=8
  font="Hack Nerd Font 10"
  frame_color="#3d59a1"
  frame_width=2
  horizontal_padding=12
  offset="12x42"
  origin="top-right"
  padding=12
  separator_color="frame"
  separator_height=2
  text_icon_padding=8
  width=360

[urgency_critical]
  background="#24283b"
  foreground="#f7768e"
  frame_color="#f7768e"
  timeout=0

[urgency_low]
  background="#1a1b26"
  foreground="#a9b1d6"
  timeout=5

[urgency_normal]
  background="#24283b"
  foreground="#c0caf5"
  frame_color="#7aa2f7"
  timeout=10
